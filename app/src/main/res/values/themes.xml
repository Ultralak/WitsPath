<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.WitsPath" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/colorInk</item>
        <item name="android:statusBarColor">@color/colorInk</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Primary branding (Wits Blue) -->
        <item name="colorPrimary">@color/colorRoute</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/colorPlate</item>
        <item name="colorOnPrimaryContainer">@color/colorInkText</item>

        <!-- Secondary / Accent (Language Dynamic) -->
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <!-- Tertiary / Semantic -->
        <item name="colorTertiary">@color/colorAccessible</item>

        <!-- Surface and Background -->
        <item name="colorSurface">@color/colorPlate</item>
        <item name="colorOnSurface">@color/colorInkText</item>
        <item name="colorSurfaceVariant">@color/colorPlateRaised</item>
        <item name="colorOnSurfaceVariant">@color/colorInkTextMuted</item>

        <item name="colorOutline">@color/colorRule</item>

        <!-- Signage Typography Wiring -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.WitsPath.Header.Large</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.WitsPath.Header</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.WitsPath.Header.Small</item>

        <item name="textAppearanceTitleLarge">@style/TextAppearance.WitsPath.Header</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.WitsPath.Code</item>

        <item name="textAppearanceBodyLarge">@style/TextAppearance.WitsPath.Body.Large</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.WitsPath.Body</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.WitsPath.Body.Small</item>
    </style>

    <style name="Theme.WitsPath" parent="Base.Theme.WitsPath" />

    <!-- Typography Foundations -->

    <style name="TextAppearance.WitsPath.Header" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorInkText</item>
    </style>

    <style name="TextAppearance.WitsPath.Header.Large" parent="TextAppearance.WitsPath.Header">
        <item name="android:textSize">32sp</item>
    </style>

    <style name="TextAppearance.WitsPath.Header.Small" parent="TextAppearance.WitsPath.Header">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TextAppearance.WitsPath.Code" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorInkText</item>
    </style>

    <style name="TextAppearance.WitsPath.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/colorInkText</item>
    </style>

    <style name="TextAppearance.WitsPath.Body.Large" parent="TextAppearance.WitsPath.Body">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TextAppearance.WitsPath.Body.Small" parent="TextAppearance.WitsPath.Body">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/colorInkTextMuted</item>
    </style>

</resources>
