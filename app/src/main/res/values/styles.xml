<!--
        Team Wavelets - WitsPath
        Append these to your existing styles.xml (or keep as a separate file in res/values).
        They assume the TextAppearance.WitsPath.* styles you already have.
     -->
<resources>
    <!--  Empty base so the dot-notation styles below resolve their implicit parents  -->
    <style name="WitsPath"/>
    <!--  ============================== DRAWER ==============================  -->
    <style name="WitsPath.DrawerRow">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="WitsPath.DrawerRow.Icon">
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="WitsPath.DrawerRow.Label" parent="TextAppearance.WitsPath.Code">
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/colorInkText</item>
    </style>
    <!--  ============================ SETTINGS ============================  -->
    <!--  Uppercase muted section header, matching the directory-board look  -->
    <style name="WitsPath.SectionLabel" parent="TextAppearance.WitsPath.Header">
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/colorInkTextMuted</item>
    </style>
    <!--  Grouped container: colorRule shows through as 1dp hairlines between rows  -->
    <style name="WitsPath.Plate">
        <item name="android:orientation">vertical</item>
        <item name="android:background">@color/colorRule</item>
        <item name="android:divider">@drawable/directory_divider</item>
        <item name="android:showDividers">middle</item>
    </style>
    <style name="WitsPath.SettingRow">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:background">@color/colorPlate</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>
    <!--  Same plate, but stacked content (chip groups, sliders)  -->
    <style name="WitsPath.SettingRow.Column">
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">start</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>
    <style name="WitsPath.SettingRow.Icon">
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="WitsPath.SettingRow.TextGroup">
        <item name="android:orientation">vertical</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">12dp</item>
    </style>
    <style name="WitsPath.SettingRow.Title" parent="TextAppearance.WitsPath.Code">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/colorInkText</item>
    </style>
    <style name="WitsPath.SettingRow.Subtitle" parent="TextAppearance.WitsPath.Body">
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/colorInkTextMuted</item>
    </style>
    <style name="WitsPath.SettingRow.Chevron">
        <item name="android:alpha">0.5</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <!--  The switch itself is not focusable; the whole row toggles it, which gives
             TalkBack one target instead of two.  -->
    <style name="WitsPath.SettingRow.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
    </style>
    <!--  ============================ LANGUAGE ============================  -->
    <style name="WitsPath.LanguageRow">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:background">@color/colorPlate</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingEnd">20dp</item>
    </style>
    <style name="WitsPath.LanguageRow.TextGroup">
        <item name="android:orientation">vertical</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>
    <style name="WitsPath.LanguageRow.Check">
        <item name="android:importantForAccessibility">no</item>
    </style>
    <!--  The 3dp amber signage tick used down the left edge of plates  -->
    <style name="WitsPath.Tick">
        <item name="android:background">@color/colorRoute</item>
    </style>
    <!--  ============================== FORMS ==============================  -->
    <style name="WitsPath.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/colorRoute</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxCornerRadiusTopStart">4dp</item>
        <item name="boxCornerRadiusTopEnd">4dp</item>
        <item name="boxCornerRadiusBottomStart">4dp</item>
        <item name="boxCornerRadiusBottomEnd">4dp</item>
        <item name="hintTextColor">@color/colorRoute</item>
        <item name="android:textColorHint">@color/colorInkTextMuted</item>
        <item name="startIconTint">@color/colorInkTextMuted</item>
        <item name="endIconTint">@color/colorInkTextMuted</item>
        <item name="errorTextColor">@color/colorFlag</item>
        <item name="boxStrokeErrorColor">@color/colorFlag</item>
        <item name="helperTextTextColor">@color/colorInkTextMuted</item>
    </style>
</resources>