<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Background, cool-toned ink rather than flat black -->
    <color name="colorInk">#0D1013</color>

    <!-- Row/surface fill -->
    <color name="colorPlate">#15181C</color>

    <!-- Sheets, elevated surfaces -->
    <color name="colorPlateRaised">#1C2126</color>

    <!-- Hairline dividers, default vs. emphasis -->
    <color name="colorRule">#262B31</color>
    <color name="colorRuleStrong">#3A414A</color>

    <!-- Primary/secondary text -->
    <color name="colorInkText">#F2F4F6</color>
    <color name="colorInkTextMuted">#8D96A1</color>

    <!-- Warm amber, the one accent, used only for the active path and primary actions -->
    <color name="colorRoute">#F2A93B</color>

    <!-- Semantic teal, step-free/accessible indicator -->
    <color name="colorAccessible">#34C29B</color>

    <!-- Semantic red, reported/blocked-path indicator -->
    <color name="colorFlag">#E5594F</color>

    <!-- Compatibility mappings for existing layouts if needed,
         though we are rewriting them to use the new names -->
    <color name="colorBackground">@color/colorInk</color>
    <color name="colorSurface">@color/colorPlate</color>
    <color name="colorOnBackground">@color/colorInkText</color>
    <color name="colorOnBackgroundMuted">@color/colorInkTextMuted</color>
    <color name="colorAccent">@color/colorRoute</color>
    <color name="colorOutline">@color/colorRule</color>
    <color name="colorOutlineVariant">#4D4D4D</color>

        <!-- System default - deliberately hueless, it is not a language -->
        <color name="colorLangSystem">#9BA7B5</color>
        <color name="colorLangSystemDim">#339BA7B5</color>

        <!-- English - blue, 220 -->
        <color name="colorLangEnglish">#5B93F0</color>
        <color name="colorLangEnglishDim">#335B93F0</color>

        <!-- isiZulu - violet, 265 -->
        <color name="colorLangZulu">#A47BF0</color>
        <color name="colorLangZuluDim">#33A47BF0</color>

        <!-- Sesotho - pink, 325 -->
        <color name="colorLangSesotho">#EC6EA9</color>
        <color name="colorLangSesothoDim">#33EC6EA9</color>

        <!-- Setswana - lime, 85 -->
        <color name="colorLangSetswana">#A3CE4E</color>
        <color name="colorLangSetswanaDim">#33A3CE4E</color>

        <!-- isiXhosa - cyan, 195 -->
        <color name="colorLangXhosa">#3EB8E0</color>
        <color name="colorLangXhosaDim">#333EB8E0</color>

        <!-- Afrikaans - green, 130 -->
        <color name="colorLangAfrikaans">#63C55F</color>
        <color name="colorLangAfrikaansDim">#3363C55F</color>

        <!-- Spare hues if you add more languages later:
             Xitsonga  #D98CE8 (290, orchid)
             Tshivenda #7FD4C0 (168 - too close to colorAccessible, avoid)
             Sepedi    #6FA8F5 (215 - too close to English, avoid)
             siSwati   #C9A227 (45 - too close to colorRoute, avoid)
             Prefer 240 (#7C85F2) and 305 (#C978E8) next. -->

</resources>
