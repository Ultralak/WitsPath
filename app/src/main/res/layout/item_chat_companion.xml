<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:paddingStart="8dp"
    android:paddingTop="2dp"
    android:paddingEnd="48dp"
    android:paddingBottom="2dp">

    <ImageView
        android:id="@+id/chatCompanionAvatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="bottom"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_avatar_circle"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_app_logo" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bubble_companion"
        android:orientation="vertical"
        android:padding="12dp"
        android:elevation="1dp">

        <TextView
            android:id="@+id/chatCompanionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/colorInkText"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/chatBadgeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/colorInkTextMuted"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Route Card matching item_route_option style -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/chatRouteCard"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/colorPlate"
            app:strokeWidth="1dp"
            app:strokeColor="@color/colorRule"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            android:visibility="gone">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <View
                    android:id="@+id/routeStripe"
                    android:layout_width="6dp"
                    android:layout_height="0dp"
                    android:background="@color/colorRoute"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/routeStripe"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:id="@+id/chatRouteSummary"
                        style="@style/TextAppearance.WitsPath.Code"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/colorRoute"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/chatRouteDetail"
                        style="@style/TextAppearance.WitsPath.Body.Small"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/colorInkTextMuted" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chatShowOnMapButton"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="40dp"
                            android:textSize="12sp"
                            android:text="@string/companion_show_on_map" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chatStartNavButton"
                            style="@style/WitsPath.Button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:minHeight="40dp"
                            android:textSize="12sp"
                            android:text="@string/companion_start_navigation" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chatRouteShareButton"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="40dp"
                        android:textSize="12sp"
                        android:text="@string/companion_share" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chatStopChip"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/companion_stop"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/chatCompanionTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/colorInkTextMuted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
