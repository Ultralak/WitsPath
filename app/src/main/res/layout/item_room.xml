<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/roomRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/colorPlate"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <!-- The 3dp amber tick -->
    <View
        android:id="@+id/roomTick"
        android:layout_width="3dp"
        android:layout_height="0dp"
        android:background="@color/colorRoute"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/roomTick"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/roomNameText"
            style="@style/TextAppearance.WitsPath.Code"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="WSS 102"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/roomChevron" />

        <TextView
            android:id="@+id/roomTypeText"
            style="@style/TextAppearance.WitsPath.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Lecture Room"
            app:layout_constraintTop_toBottomOf="@id/roomNameText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/roomChevron" />

        <ImageView
            android:id="@+id/roomChevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/colorInkTextMuted"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
