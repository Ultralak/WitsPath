<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/reportRow"
    style="@style/WitsPath.SettingRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="horizontal">

    <View
        android:id="@+id/reportTick"
        style="@style/WitsPath.Tick"
        android:layout_width="4dp"
        android:layout_height="24dp" />

    <LinearLayout
        style="@style/WitsPath.SettingRow.TextGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <TextView
            android:id="@+id/reportIssueTypeText"
            style="@style/WitsPath.SettingRow.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Broken Lift" />

        <TextView
            android:id="@+id/reportDateText"
            style="@style/WitsPath.SettingRow.Subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="3 days ago" />

    </LinearLayout>

    <TextView
        android:id="@+id/reportStatusText"
        style="@style/TextAppearance.WitsPath.Body.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_language_swatch"
        android:backgroundTint="@color/colorAccentSurface"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textColor="@color/colorAccent"
        tools:text="Pending" />

</LinearLayout>
