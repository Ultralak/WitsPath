<?xml version="1.0" encoding="utf-8"?>
<!--
    Team Wavelets - WitsPath
    item_report.xml - one report row, inflated into myReportsContainer by
    MyReportsActivity. The status pill turns red once the report's edge has
    been flagged (edges/{edgeId}.status == "flagged"), amber while pending.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/reportRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/colorPlate"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <!-- The 3dp amber tick -->
    <View
        android:id="@+id/reportTick"
        style="@style/WitsPath.Tick"
        android:layout_width="3dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/reportTick"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/reportStatusText">

            <TextView
                android:id="@+id/reportIssueTypeText"
                style="@style/TextAppearance.WitsPath.Code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:text="@string/broken_lift" />

            <TextView
                android:id="@+id/reportDateText"
                style="@style/TextAppearance.WitsPath.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="3 days ago" />

        </LinearLayout>

        <TextView
            android:id="@+id/reportStatusText"
            style="@style/TextAppearance.WitsPath.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_value_pill"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="@color/colorRoute"
            android:text="@string/report_status_pending"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
