<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/reportRow"
    style="@style/WitsPath.SettingRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        style="@style/WitsPath.SettingRow.TextGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <TextView
            android:id="@+id/reportIssueTypeText"
            style="@style/WitsPath.SettingRow.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Broken Lift" />

        <TextView
            android:id="@+id/reportDateText"
            style="@style/WitsPath.SettingRow.Subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="3 days ago" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/reportDeleteButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/dialog_delete_report_title"
        android:src="@drawable/ic_delete"
        app:tint="@color/colorFlag" />

    <ImageButton
        android:id="@+id/reportStatusButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/report_status_pending"
        android:src="@drawable/ic_clock_outline"
        app:tint="@color/colorRoute" />

</LinearLayout>
