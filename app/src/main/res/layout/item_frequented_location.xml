<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/frequentedLocationRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/colorPlate"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <!-- The 3dp amber tick -->
    <View
        android:id="@+id/locationTick"
        android:layout_width="3dp"
        android:layout_height="0dp"
        android:background="@color/colorRoute"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/locationTick"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/locationNameText"
            style="@style/TextAppearance.WitsPath.Code"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="WSS 102"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/locateIconButton" />

        <TextView
            android:id="@+id/lastVisitedText"
            style="@style/TextAppearance.WitsPath.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/last_visited_on"
            app:layout_constraintTop_toBottomOf="@id/locationNameText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/locateIconButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/locateIconButton"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:icon="@drawable/ic_my_location"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/colorRoute"
            app:backgroundTint="@color/colorPlateRaised"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
