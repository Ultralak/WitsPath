<?xml version="1.0" encoding="utf-8"?>
<!--
    Team Wavelets - WitsPath
    item_language_option.xml - inflate into languageListContainer if you build the
    language list from a String[][] of {bcp47Tag, englishName, nativeName}.
    Set languageOptionCheck visibility to VISIBLE for the active tag only.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/languageOptionRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/colorPlate"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingEnd="20dp">

    <View
        android:id="@+id/languageOptionTick"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@color/colorLangSystem" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/languageOptionNameText"
            style="@style/TextAppearance.WitsPath.Code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:text="@string/language_english"
            android:clickable="false"
            android:focusable="false"/>

        <TextView
            android:id="@+id/languageOptionNativeText"
            style="@style/TextAppearance.WitsPath.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/language_english"
            android:clickable="false"
            android:focusable="false"/>

    </LinearLayout>

    <ImageView
        android:id="@+id/languageOptionCheck"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_check"
        android:visibility="invisible"
        android:importantForAccessibility="no"
        app:tint="@color/colorRoute" />

</LinearLayout>
