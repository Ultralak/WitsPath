<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:background="@color/colorPlate">

    <View
        android:id="@+id/languageOptionTick"
        android:layout_width="4dp"
        android:layout_height="32dp"
        android:layout_marginEnd="16dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/languageOptionNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/colorInkText"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/languageOptionNativeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/colorInkTextMuted"
            android:textSize="14sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/languageOptionCheck"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_check"
        android:visibility="gone" />
</LinearLayout>
