<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/languageOptionRow"
    style="@style/WitsPath.SettingRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="horizontal"
    android:paddingEnd="20dp">

    <View
        android:id="@+id/languageOptionTick"
        android:layout_width="4dp"
        android:layout_height="24dp"
        android:background="@color/colorLangSystem" />

    <LinearLayout
        style="@style/WitsPath.SettingRow.TextGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <TextView
            android:id="@+id/languageOptionNameText"
            style="@style/WitsPath.SettingRow.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="English" />

        <TextView
            android:id="@+id/languageOptionNativeText"
            style="@style/WitsPath.SettingRow.Subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="English" />

    </LinearLayout>

    <ImageView
        android:id="@+id/languageOptionCheck"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_check"
        android:visibility="gone"
        android:importantForAccessibility="no"
        app:tint="@color/colorAccent"
        tools:visibility="visible" />

</LinearLayout>
