<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/floorPlanRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorInk"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/floorPlanToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorInk"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/colorRoute"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/fromText"
                    style="@style/TextAppearance.WitsPath.Body.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Matrix Hub"
                    android:textColor="@color/colorInkTextMuted" />

                <TextView
                    android:id="@+id/toText"
                    style="@style/TextAppearance.WitsPath.Header.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Matrix Lab"
                    android:textColor="@color/colorRoute" />
            </LinearLayout>

            <View
                android:layout_width="2dp"
                android:layout_height="24dp"
                android:layout_marginStart="16dp"
                android:background="@color/colorAccent" />
        </LinearLayout>

    </com.google.android.material.appbar.MaterialToolbar>

    <FrameLayout
        android:id="@+id/floorPlanMapWrapper"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/floorPlanToolbar"
        app:layout_constraintBottom_toTopOf="@id/reportIssueButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.example.witspath.ui.ZoomableFrameLayout
            android:id="@+id/floorPlanZoomContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/floorPlanImageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="matrix"
                android:src="@drawable/campusmap"
                android:contentDescription="@string/floor_plan" />

            <com.example.witspath.ui.FloorPlanRouteView
                android:id="@+id/floorPlanRouteView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </com.example.witspath.ui.ZoomableFrameLayout>

        <include
            layout="@layout/map_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end" />
    </FrameLayout>

    <!-- Elevator call-panel floor switcher -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/reportIssueButton"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="20dp"
        android:text="@string/report_issue_on_path"
        android:textColor="@color/colorFlag"
        app:icon="@drawable/ic_flag"
        app:iconTint="@color/colorFlag"
        app:strokeColor="@color/colorFlag"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
