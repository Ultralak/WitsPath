<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/stepNumberText"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_step_number"
        android:gravity="center"
        android:textColor="@color/webInk"
        android:textSize="12sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/stepIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="12dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_next"
        app:tint="@color/webInk" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/stepTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/webInk"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stepSubtitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/webMuted"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
