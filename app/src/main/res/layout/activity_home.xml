<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeDrawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:id="@+id/homeRootLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorSurface"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/homeToolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_header_topbar"
            app:contentInsetStartWithNavigation="0dp"
            app:navigationContentDescription="@string/cd_open_menu"
            app:navigationIcon="@drawable/ic_menu"
            app:navigationIconTint="@color/colorTextOnPrimary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/webProductTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/web_accessible_navigation"
                        android:textColor="@color/colorTextOnPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/web_inclusive_subtitle"
                        android:textColor="#D6E7FA"
                        android:textSize="10sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="#55FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:lines="2"
                    android:text="@string/web_wits_wordmark"
                    android:textColor="@color/colorTextOnPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <ScrollView
            android:id="@+id/homePhoneScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/colorPanel"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/homePhoneContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/homeRoutePanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/colorPanel"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/destinationCard"
                        android:layout_width="match_parent"
                        android:layout_height="112dp"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginEnd="14dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_card_surface"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="29dp"
                            android:layout_height="36dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_route_destination" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/web_destination"
                                android:textColor="@color/colorTextMuted"
                                android:textSize="12sp" />

                            <Spinner
                                android:id="@+id/toLocationSpinner"
                                android:layout_width="match_parent"
                                android:layout_height="38dp"
                                android:background="@drawable/bg_card_outline"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/web_campus_name"
                                android:textColor="@color/colorTextMuted"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/travelModes"
                        android:layout_width="match_parent"
                        android:layout_height="91dp"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="14dp"
                        android:layout_marginBottom="10dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/modeWheelchair"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_mode_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_wheelchair"
                                app:tint="@color/colorBrandPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="@string/web_mode_wheelchair"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/modeWalkingAid"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_mode_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_walking_aid"
                                app:tint="@color/colorBrandPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="@string/web_mode_walking_aid"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/modeVisual"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_mode_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_visibility"
                                app:tint="@color/colorBrandPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="@string/web_mode_visual"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/modeGeneral"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_mode_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_standard_walking"
                                app:tint="@color/colorBrandPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="@string/web_mode_general"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="74dp"
                        android:background="@color/colorSurface"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="28dp"
                        android:paddingEnd="28dp">

                        <ImageView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_clock_outline"
                            app:tint="@color/colorTextPrimary" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/web_estimated_time"
                                android:textColor="@color/colorTextMuted"
                                android:textSize="12sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/estimatedTime"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="—"
                                    android:textColor="@color/colorTextPrimary"
                                    android:textSize="17sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/estimatedDistance"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="5dp"
                                    android:textColor="@color/colorTextMuted"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/startCard"
                        android:layout_width="match_parent"
                        android:layout_height="69dp"
                        android:background="@color/colorSurface"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="28dp"
                        android:paddingEnd="20dp">

                        <ImageView
                            android:layout_width="29dp"
                            android:layout_height="36dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_route_start" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/web_start"
                                android:textColor="@color/colorTextMuted"
                                android:textSize="12sp" />

                            <Spinner
                                android:id="@+id/fromLocationSpinner"
                                android:layout_width="match_parent"
                                android:layout_height="36dp"
                                android:background="@android:color/transparent" />
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/refreshLocation"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_card_outline"
                            android:contentDescription="@string/settings_auto_locate_title"
                            android:src="@drawable/ic_my_location"
                            app:tint="@color/colorBrandPrimary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/guidanceText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:text="@string/web_guidance_initial"
                        android:textColor="@color/colorTextMuted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/statusMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="8dp"
                        android:textColor="@color/colorSuccess"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/stepsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/navigateButton"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="18dp"
                        android:background="@drawable/bg_button_primary"
                        android:text="@string/start_navigation"
                        android:textAllCaps="false"
                        android:textColor="@color/colorTextOnPrimary"
                        app:icon="@drawable/ic_search"
                        app:iconGravity="textStart"
                        app:iconTint="@color/colorTextOnPrimary" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/homeMapPanel"
                    android:layout_width="match_parent"
                    android:layout_height="420dp"
                    android:background="@color/colorBackground"
                    android:minHeight="310dp">

                    <com.example.witspath.ui.ZoomableFrameLayout
                        android:id="@+id/homeMapContainer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/colorBackground"
                        android:clipChildren="true"
                        android:contentDescription="@string/cd_map_view">

                        <ImageView
                            android:id="@+id/homeFloorPlanImageView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/floor_plan"
                            android:scaleType="fitXY"
                            android:src="@drawable/campusmap" />

                        <com.example.witspath.ui.FloorPlanRouteView
                            android:id="@+id/homeFloorPlanRouteView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </com.example.witspath.ui.ZoomableFrameLayout>

                    <include
                        layout="@layout/map_controls"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end" />

                    <!-- Detailed Map Legend Card -->
                    <LinearLayout
                        android:id="@+id/mapLegend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="12dp"
                        android:background="@drawable/bg_card_legend"
                        android:elevation="4dp"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="16dp"
                                android:layout_height="3dp"
                                android:background="@color/colorRoute" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/web_suggested_route"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_route_start" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/web_start"
                                android:textColor="@color/colorTextMuted"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_route_destination" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/web_destination"
                                android:textColor="@color/colorTextMuted"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_wheelchair"
                                app:tint="@color/colorBrandPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/web_legend_accessible"
                                android:textColor="@color/colorTextMuted"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="16dp"
                                android:layout_height="6dp"
                                android:background="@color/colorRampPath" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/legend_ramp_path"
                                android:textColor="@color/colorTextMuted"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="16dp"
                                android:layout_height="6dp"
                                android:background="@color/colorBorder" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/legend_stairs"
                                android:textColor="@color/colorTextMuted"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/homeNavigationView"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/colorSurface"
        android:fitsSystemWindows="true">

        <include layout="@layout/nav_drawer_content" />
    </com.google.android.material.navigation.NavigationView>
</androidx.drawerlayout.widget.DrawerLayout>
