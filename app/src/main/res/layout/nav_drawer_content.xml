<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorInk"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- ============================ HEADER / ACCOUNT ============================ -->
        <LinearLayout
            android:id="@+id/navHeaderAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/colorRoute"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:paddingTop="48dp"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/navAvatarImage"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_avatar_circle"
                android:backgroundTint="#22FFFFFF"
                android:padding="12dp"
                android:src="@drawable/ic_account"
                app:tint="#FFFFFF"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/navUserNameText"
                    style="@style/TextAppearance.WitsPath.Code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#FFFFFF"
                    tools:text="Guest User" />

                <TextView
                    android:id="@+id/navUserEmailText"
                    style="@style/TextAppearance.WitsPath.Body.Small"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#CCFFFFFF"
                    tools:text="Tap to sign in" />

            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="#FFFFFF"
                android:importantForAccessibility="no" />

        </LinearLayout>

        <!-- ============================== NAVIGATE ============================== -->
        <TextView
            style="@style/WitsPath.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_section_navigate" />

        <LinearLayout
            android:id="@+id/navHomeRow"
            style="@style/WitsPath.DrawerRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home"
                app:tint="#002C5F"
                android:importantForAccessibility="no" />

            <TextView
                style="@style/WitsPath.DrawerRow.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/nav_home" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navMyReportsRow"
            style="@style/WitsPath.DrawerRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_flag"
                app:tint="#002C5F"
                android:importantForAccessibility="no" />

            <TextView
                style="@style/WitsPath.DrawerRow.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/nav_my_reports" />

            <TextView
                android:id="@+id/navMyReportsCount"
                style="@style/TextAppearance.WitsPath.Code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_language_swatch"
                android:backgroundTint="@color/colorAccent"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                tools:text="3" />

        </LinearLayout>

        <!-- ============================== SETTINGS ============================== -->
        <TextView
            style="@style/WitsPath.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_section_settings" />

        <LinearLayout
            android:id="@+id/navSettingsRow"
            style="@style/WitsPath.DrawerRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_settings"
                app:tint="#002C5F"
                android:importantForAccessibility="no" />

            <TextView
                style="@style/WitsPath.DrawerRow.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/nav_settings" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navLanguageRow"
            style="@style/WitsPath.DrawerRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_language"
                app:tint="#002C5F"
                android:importantForAccessibility="no" />

            <TextView
                style="@style/WitsPath.DrawerRow.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/nav_language" />

            <View
                android:id="@+id/navLanguageSwatch"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_language_swatch" />

            <TextView
                android:id="@+id/navLanguageValueText"
                style="@style/TextAppearance.WitsPath.Body.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                tools:text="English" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navAccessibilityRow"
            style="@style/WitsPath.DrawerRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_accessible"
                app:tint="#002C5F"
                android:importantForAccessibility="no" />

            <TextView
                style="@style/WitsPath.DrawerRow.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/nav_accessibility" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navPreferencesRow"
            style="@style/WitsPath.DrawerRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_tune"
                app:tint="#002C5F"
                android:importantForAccessibility="no" />

            <TextView
                style="@style/WitsPath.DrawerRow.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/nav_preferences" />

        </LinearLayout>

        <!-- =============================== ACCOUNT =============================== -->
        <TextView
            style="@style/WitsPath.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_section_account" />

        <LinearLayout
            android:id="@+id/navLogInRow"
            style="@style/WitsPath.DrawerRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_login"
                app:tint="#002C5F"
                android:importantForAccessibility="no" />

            <TextView
                style="@style/WitsPath.DrawerRow.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/nav_log_in" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSignUpRow"
            style="@style/WitsPath.DrawerRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_person_add"
                app:tint="#002C5F"
                android:importantForAccessibility="no" />

            <TextView
                style="@style/WitsPath.DrawerRow.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/nav_sign_up" />

        </LinearLayout>

        <!-- =============================== SUPPORT =============================== -->
        <TextView
            style="@style/WitsPath.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_section_support" />

        <LinearLayout
            android:id="@+id/navHelpRow"
            style="@style/WitsPath.DrawerRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_help"
                app:tint="#002C5F"
                android:importantForAccessibility="no" />

            <TextView
                style="@style/WitsPath.DrawerRow.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/nav_help" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navAboutRow"
            style="@style/WitsPath.DrawerRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_info"
                app:tint="#002C5F"
                android:importantForAccessibility="no" />

            <TextView
                style="@style/WitsPath.DrawerRow.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/nav_about" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navPopulateFirestoreRow"
            style="@style/WitsPath.DrawerRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_sync"
                app:tint="#002C5F"
                android:importantForAccessibility="no" />

            <TextView
                style="@style/WitsPath.DrawerRow.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/nav_populate_firestore" />

        </LinearLayout>

        <!-- ================================ LOG OUT ================================ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:background="@color/colorRule" />

        <LinearLayout
            android:id="@+id/navLogOutRow"
            style="@style/WitsPath.DrawerRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_logout"
                app:tint="@color/colorFlag"
                android:importantForAccessibility="no" />

            <TextView
                style="@style/WitsPath.DrawerRow.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/nav_log_out"
                android:textColor="@color/colorFlag" />

        </LinearLayout>

        <TextView
            android:id="@+id/navVersionText"
            style="@style/TextAppearance.WitsPath.Body.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:text="@string/app_version"
            android:textColor="@color/colorInkTextMuted" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
