<?xml version="1.0" encoding="utf-8"?>
<!--
    Team Wavelets - WitsPath
    item_saved_place.xml - one saved place row, inflated into
    preferencesSavedPlacesContainer. Tag the row with the nodeId so the delete
    button can remove the right document.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/savedPlaceRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/colorPlate"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingEnd="12dp">

    <View
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:background="@color/colorRoute" />

    <ImageView
        android:id="@+id/savedPlaceIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="16dp"
        android:src="@drawable/ic_bookmark"
        android:importantForAccessibility="no"
        app:tint="@color/colorInkText"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/savedPlaceNameText"
            style="@style/TextAppearance.WitsPath.Code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:text="WSS 102" />

        <TextView
            android:id="@+id/savedPlaceDetailText"
            style="@style/TextAppearance.WitsPath.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Wits Science Stadium - Ground floor" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/savedPlaceDeleteButton"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/cd_remove_saved_place"
        app:icon="@drawable/ic_delete"
        app:iconPadding="0dp"
        app:iconTint="@color/colorFlag" />

</LinearLayout>
