<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/preferencesRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorInk"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/preferencesToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorInk"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/colorRoute"
        app:title="@string/preferences_title"
        app:titleTextColor="@color/colorRoute"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/preferencesScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/preferencesToolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- ============================ MY PLACES ============================ -->
            <TextView
                style="@style/WitsPath.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/preferences_section_places" />

            <LinearLayout
                style="@style/WitsPath.Plate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/preferencesHomeLocationRow"
                    style="@style/WitsPath.SettingRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        style="@style/WitsPath.SettingRow.Icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_home" />

                    <LinearLayout
                        style="@style/WitsPath.SettingRow.TextGroup"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content">

                        <TextView
                            style="@style/WitsPath.SettingRow.Title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/preferences_home_location_title" />

                        <TextView
                            android:id="@+id/preferencesHomeLocationValueText"
                            style="@style/WitsPath.SettingRow.Subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="Matrix Hub" />

                    </LinearLayout>

                    <ImageView
                        style="@style/WitsPath.SettingRow.Chevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right" />

                </LinearLayout>

            </LinearLayout>

            <!-- ============================== RESET ============================== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/preferencesResetButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_margin="24dp"
                android:text="@string/preferences_reset_all"
                android:textColor="@color/colorFlag"
                app:strokeColor="@color/colorFlag"
                app:icon="@drawable/ic_delete"
                app:iconTint="@color/colorFlag"
                app:iconGravity="textStart"
                app:cornerRadius="8dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
