<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/chatMessageText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/colorPlateRaised"
        android:padding="12dp"
        android:textColor="@color/colorInkText"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/chatBadgeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingTop="2dp"
        android:paddingEnd="4dp"
        android:textColor="@color/colorInkText"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/chatRouteCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@color/colorPlateRaised"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/chatRouteSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/colorInkText"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chatRouteDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/colorInkText" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chatShowOnMapButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/companion_show_on_map" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chatStartNavButton"
                style="@style/WitsPath.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/companion_start_navigation" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chatShareButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/companion_share" />
    </LinearLayout>
</LinearLayout>
